{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@officewrite/core": [
        "packages/core/src/index.ts"
      ],
      "@officewrite/openxml": [
        "packages/openxml/src/index.ts"
      ],
      "@tests/*": [
        "tests/*"
      ]
    }
  },
  "include": [
    "tests",
    "apps/desktop/test",
    "playwright.config.ts",
    "apps/desktop/src/global.d.ts",
    "playwright.electron.config.ts"
  ]
}
